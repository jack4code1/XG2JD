# Copy to .env or export these variables before starting the backend.
# Never commit real credentials.

MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-root-password

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password

DEEPSEEK_API_KEY=replace-with-deepseek-api-key
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Required only when starting the optional observability profile.
GRAFANA_PASSWORD=replace-with-local-grafana-password
