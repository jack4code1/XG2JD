# 复制此文件为 .env 后填入实际值
# cp .env.example .env

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis (默认无密码)
# REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password

# JWT
JWT_SECRET=your-jwt-secret-min-32-bytes-long

# Grafana (Docker)
GRAFANA_PASSWORD=your_grafana_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password